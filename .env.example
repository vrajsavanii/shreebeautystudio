NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
WHATSAPP_VERIFY_TOKEN=shree_beauty_webhook_token_2026

# ─────────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API — SERVER SIDE ONLY (never NEXT_PUBLIC_)
# Fill these in from Meta Developer Dashboard → WhatsApp → API Setup
# ─────────────────────────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_meta_access_token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id

# ─────────────────────────────────────────────────────────────────
# AI Copilot Multi-Provider API Credentials (Groq, NVIDIA NIM, Gemini)
# ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
# ─────────────────────────────────────────────────────────────────
# Customer Authentication & Notification Credentials
# ─────────────────────────────────────────────────────────────────
CUSTOMER_AUTH_JWT_SECRET=your_super_secret_jwt_random_string_here
RESEND_API_KEY=your_resend_email_api_key_here

# ─────────────────────────────────────────────────────────────────
# Phone.Email Free Mobile OTP Verification (https://admin.phone.email)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE_EMAIL_CLIENT_ID=your_phone_email_client_id_here
